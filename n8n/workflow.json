      "id": "2",
      "name": "Obtener Columnas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const outputCards = [];\n\n// Procesar todas las columnas y sus cards\nfor (const item of items) {\n    const column = item.json;\n    \n    console.log(`Processing column: ${column.name}`);\n    \n    if (column.cards && Array.isArray(column.cards)) {\n        console.log(`Column has ${column.cards.length} cards`);\n        \n        for (const card of column.cards) {\n            // Formatear fecha para CSV\n            let formattedDate = '';\n            if (card.createdAt) {\n                try {\n                    const date = new Date(card.createdAt);\n                    formattedDate = date.toLocaleDateString('es-ES', {\n                        year: 'numeric',\n                        month: '2-digit',\n                        day: '2-digit',\n                        hour: '2-digit',\n                        minute: '2-digit'\n                    });\n                } catch (error) {\n                    formattedDate = String(card.createdAt);\n                }\n            }\n            \n            outputCards.push({\n                json: {\n                    id: card._id,\n                    title: card.title || '',\n                    description: card.description || '',\n                    column: column.name,\n                    boardTitle: column.boardTitle,\n                    createdAt: formattedDate\n                }\n            });\n        }\n    } else {\n        console.warn(`Column ${column.name} has no cards or cards is not an array`);\n    }\n}\n\nconsole.log(`Total cards processed: ${outputCards.length}`);\nreturn outputCards;"
      },
      "id": "3",
      "name": "Procesar Tarjetas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "options": {
          "delimiter": ",",
          "fileName": "=kanban-export-{{ new Date().toISOString().split('T')[0] }}.csv",
          "headerRow": true
        }
      },
      "id": "4",
      "name": "Convertir a CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [900, 300]
    },
    {
