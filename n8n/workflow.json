      "typeVersion": 3.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "fromEmail": "francoguevara93@gmail.com",
        "toEmail": "={{ $json.recipientEmail || 'francoguevara93@gmail.com' }}",
        "subject": "📋 Exportación Kanban - Tablero Completado",
        "html": "=<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"></head>\n<body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n  <div style=\"max-width: 600px; margin: 20px auto; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\n    <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; text-align: center; border-radius: 8px 8px 0 0;\">\n      <h1 style=\"margin: 0; font-size: 24px;\">📋 Exportación Kanban Completada</h1>\n      <p style=\"margin: 10px 0 0 0; opacity: 0.9;\">Tu tablero ha sido exportado exitosamente</p>\n    </div>\n    <div style=\"padding: 30px;\">\n      <p style=\"font-size: 16px; margin-bottom: 20px;\">¡Hola! 👋</p>\n      <p style=\"font-size: 16px; margin-bottom: 20px;\">Tu exportación del tablero Kanban está lista y adjunta a este correo.</p>\n      \n      <div style=\"background: #f8f9fa; padding: 25px; border-radius: 8px; margin: 25px 0; border-left: 4px solid #667eea;\">\n        <h3 style=\"margin: 0 0 15px 0; color: #333; font-size: 18px;\">📊 Resumen de la Exportación</h3>\n        <p style=\"margin: 8px 0; font-size: 14px;\"><strong>📈 Total de tarjetas exportadas:</strong> {{ $('Procesar Tarjetas').all().length }} tarjetas</p>\n        <p style=\"margin: 8px 0; font-size: 14px;\"><strong>📁 Nombre del archivo:</strong> kanban-export-{{ new Date().toISOString().split('T')[0] }}.csv</p>\n        <p style=\"margin: 8px 0; font-size: 14px;\"><strong>📅 Fecha de exportación:</strong> {{ new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) }}</p>\n        <p style=\"margin: 8px 0; font-size: 14px;\"><strong>⏰ Hora:</strong> {{ new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) }}</p>\n      </div>\n      \n      <div style=\"background: #e8f4fd; padding: 20px; border-radius: 8px; margin: 25px 0; border: 1px solid #bee5eb;\">\n        <h4 style=\"margin: 0 0 10px 0; color: #0c5460; font-size: 16px;\">💡 ¿Cómo usar el archivo?</h4>\n        <ul style=\"margin: 0; padding-left: 20px; font-size: 14px; color: #0c5460;\">\n          <li>Abre el archivo CSV en Excel, Google Sheets o cualquier editor de hojas de cálculo</li>\n          <li>Las columnas incluyen: ID, Título, Descripción, Columna y Fecha de creación</li>\n          <li>Puedes filtrar y ordenar los datos según tus necesidades</li>\n        </ul>\n      </div>\n      \n      <p style=\"font-size: 16px; margin-top: 30px;\">¡Gracias por usar nuestro sistema Kanban! 🚀</p>\n      <p style=\"font-size: 14px; color: #666; margin-top: 20px;\">Si tienes alguna pregunta, no dudes en contactarnos.</p>\n    </div>\n    <div style=\"background: #f8f9fa; padding: 20px; text-align: center; border-radius: 0 0 8px 8px; border-top: 1px solid #dee2e6;\">\n      <p style=\"margin: 0; font-size: 12px; color: #6c757d;\">Este es un correo automático del sistema de gestión Kanban</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {
          "attachments": "data"
        }
      },
